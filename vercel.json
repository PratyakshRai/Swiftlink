{
  "version": 2,
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__route=/api/:path*"
    },
    {
      "source": "/r/:code",
      "destination": "/api/index?__route=/r/:code"
    },
    {
      "source": "/health",
      "destination": "/api/index?__route=/health"
    }
  ]
}
