# Required for Vercel deployment. Never commit your real values.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/swiftlink?retryWrites=true&w=majority
REDIS_URL=rediss://default:PASSWORD@HOST:PORT
SESSION_SECRET=replace-with-a-cryptographically-random-secret-at-least-32-characters
BASE_URL=https://your-project.vercel.app
NODE_ENV=production
TRUST_PROXY=1
